---
import { EngineeringIntelligenceLayer } from './EngineeringIntelligenceLayer';
import { ArrowRight, ArrowUpRight, CheckCircle2, ShieldCheck } from 'lucide-react';

const standards = [
  'IEC 61131-3',
  'ISA-88',
  'ISA-95',
  'ISA-18.2',
  'IEC 62443',
  'PLCopen',
];
---

<section class="relative overflow-hidden pt-28 pb-20 md:pt-32 md:pb-28 border-b border-border-subtle bg-gradient-to-b from-bg-page via-bg-page to-bg-elevated/40">
  <!-- Subtle Industrial Background Accent Glow -->
  <div
    class="absolute right-0 top-0 -z-10 h-[500px] w-[500px] rounded-full bg-accent-primary/5 blur-[140px] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-container mx-auto px-6 md:px-8 lg:px-12">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      
      <!-- Left Column: Narrative -->
      <div class="lg:col-span-6 flex flex-col items-start min-w-0">
        
        <!-- Main Headline: 2-Line Wide Layout -->
        <h1 class="text-[2.25rem] sm:text-[3rem] md:text-[3.5rem] lg:text-[3.75rem] xl:text-[4.15rem] text-text-primary tracking-tight font-bold leading-[1.08] mb-6 text-left">
          <span class="block whitespace-nowrap">Industrial Automation,</span>
          <span class="block mt-1 re-imagined-gradient cursor-pointer">Re-Imagined.</span>
        </h1>

        <!-- Positioning Copy (Zero Em-Dashes) -->
        <p class="text-body-large text-text-secondary text-pretty mb-6 max-w-2xl leading-relaxed">
          AUTO-X builds the software infrastructure for next-generation industrial engineering.
          We develop engineering intelligence tools that empower <strong class="font-medium text-text-primary">Industrial Automation and Industry 4.0</strong> teams to <span class="text-accent-primary font-medium">design, build, verify, and operate</span> complex automation systems with greater speed, consistency, and margin confidence.
        </p>

        <!-- Mission Highlight Card -->
        <div class="p-4 rounded-panel bg-bg-panel border border-border-standard mb-8 w-full shadow-sm">
          <div class="flex items-start gap-3">
            <ShieldCheck className="w-5 h-5 text-accent-primary mt-0.5 flex-shrink-0" />
            <div>
              <span class="text-xs uppercase font-mono tracking-wider text-text-tertiary block mb-1">Mission</span>
              <p class="text-xs sm:text-sm text-text-primary font-medium leading-snug">
                Make industrial engineering more intelligent, connected, and dramatically more productive across the complete automation lifecycle.
              </p>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto mb-10">
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-standard bg-accent-primary text-white text-sm font-semibold shadow-card hover:bg-accent-hover transition-all hover:shadow-elevated active:scale-[0.98]"
          >
            <span>Get Pilot Access</span>
            <ArrowRight className="w-4 h-4" />
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-standard bg-bg-panel border border-border-standard text-text-primary text-sm font-semibold hover:bg-bg-hover hover:border-accent-border transition-colors"
          >
            <span>Book Live Demo</span>
            <ArrowUpRight className="w-4 h-4 text-text-tertiary" />
          </a>
        </div>

        <!-- Standards Compatibility -->
        <div class="w-full pt-6 border-t border-border-subtle">
          <span class="text-[11px] font-mono uppercase tracking-widest text-text-tertiary block mb-3">
            Deterministic Standards Encoded
          </span>
          <div class="flex flex-wrap items-center gap-1.5 overflow-x-auto">
            {standards.map((badge) => (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-bg-panel border border-border-subtle text-[11px] font-mono text-text-secondary whitespace-nowrap flex-shrink-0">
                <CheckCircle2 className="w-3 h-3 text-success flex-shrink-0" />
                {badge}
              </span>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Engineering Intelligence Layer Visual Island -->
      <div class="lg:col-span-6 w-full min-w-0">
        <div class="relative">
          <div class="absolute -inset-1 bg-gradient-to-r from-accent-primary/20 to-success/10 rounded-panel blur-lg -z-10 opacity-70"></div>
          <EngineeringIntelligenceLayer client:load />
        </div>
      </div>

    </div>
  </div>
</section>
