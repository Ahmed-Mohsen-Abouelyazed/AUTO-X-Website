---
import { PlcShowcase } from './PlcShowcase';
import {
  Cpu,
  Database,
  Layout,
  ArrowRight,
  CheckCircle2,
  ShieldAlert,
  Bot,
} from 'lucide-react';

const flagshipProducts = [
  {
    id: 'platx',
    icon: Layout,
    name: 'PlatX',
    tagline: 'AI-Native Industrial Engineering Operating System',
    description:
      'The unified platform connecting the complete industrial automation lifecycle. Integrates AI reasoning, encoded domain knowledge, and a unified engineering data model to transform document-driven engineering into a continuous model-driven ecosystem.',
    status: 'Platform Vision',
    statusVariant: 'accent' as const,
    highlights: [
      'Multi-agent system for every engineering discipline',
      'Unified Engineering Data Model (Single Source of Truth)',
      'Standards encoded as deterministic hard rules',
      'Integrated virtual simulation & test oracles',
      'Git-native version control & change management',
      'Multi-vendor projections (Siemens, Rockwell, Schneider, ABB)',
    ],
    cta: 'Explore Platform Vision',
    href: '#platx-os',
  },
  {
    id: 'autoplc',
    icon: Cpu,
    name: 'AUTO-PLC',
    tagline: 'PLC Engineering Workflow Automation',
    description:
      'The first PlatX module and starter MVP proof point. Transforms PLC software engineering from requirements intake to release through a deterministic, AI-assisted 6-stage compiler pipeline.',
    status: 'Demo Ready / MVP',
    statusVariant: 'accent' as const,
    highlights: [
      '6-stage gated engineering pipeline',
      'AI drafts · engines verify · engineers approve',
      'Standards-encoded validation (IEC 61131-3 / ISA-88 / ISA-18.2)',
      'Siemens TIA Portal integration (Structured Text & SCL)',
      'Deterministic, mathematically reproducible emission',
    ],
    cta: 'Book Live Demo',
    href: '#contact',
  },
  {
    id: 'autoio',
    icon: Database,
    name: 'AUTO-IO',
    tagline: 'Automatic I/O Design & Cabinet Layout',
    description:
      'Automates instrument signal mapping, rack allocation, cabinet layouts, and termination diagrams — eliminating weeks of manual spreadsheet errors.',
    status: 'Technically Validated POC',
    statusVariant: 'success' as const,
    highlights: [
      'Automatic I/O rack & channel allocation',
      'Cabinet layout & address mapping generation',
      'Termination diagram PDF generation',
      'Bidirectional graph conflict & safety validation',
      'Multi-scenario comparison & optimization',
    ],
    cta: 'Inquire About POC',
    href: '#contact',
  },
];

const lifecyclePhases = [
  {
    phase: 'Phase 1: Define & Scope',
    modules: [
      { name: 'AUTO-SCOPE', desc: 'AI-Powered Project Intake & RFQ Parser' },
      { name: 'AUTO-REQ', desc: 'Requirements Extraction & Traceability' },
      { name: 'AUTO-FEED', desc: 'Front-End Engineering Design & Estimates' },
    ],
  },
  {
    phase: 'Phase 2: Engineering Design',
    modules: [
      { name: 'AUTO-PD', desc: 'Process Design, PFD & P&ID Generation' },
      { name: 'AUTO-INST', desc: 'Instrument Index & Datasheet Generator' },
      { name: 'AUTO-IO', desc: 'Automatic I/O Allocation (Functional POC)' },
      { name: 'AUTO-ELEC', desc: 'Electrical Sizing, SLD & Cable Schedules' },
      { name: 'AUTO-NET', desc: 'Industrial Network & VLAN Architecture' },
      { name: 'AUTO-SAFE', desc: 'Functional Safety & SIL (Post-MVP, Non-AI)' },
      { name: 'AUTO-ICS/OT', desc: 'Industrial Cybersecurity (IEC 62443)' },
    ],
  },
  {
    phase: 'Phase 3: Control System Development',
    modules: [
      { name: 'AUTO-PLC', desc: 'PLC Software Engineering (Starter MVP)' },
      { name: 'AUTO-HMI', desc: 'HMI Screen & Faceplate Generation' },
      { name: 'AUTO-SCADA', desc: 'SCADA Tag, Alarm & Trend Engineering' },
      { name: 'AUTO-MES', desc: 'MES Integration & Production Tracking' },
      { name: 'AUTO-IIOT', desc: 'Unified Namespace & MQTT Sparkplug B' },
    ],
  },
  {
    phase: 'Phase 4: Documentation Automation',
    modules: [
      { name: 'AUTO-DOC', desc: 'Automated FDS, SDS, FAT & SAT Manuals' },
      { name: 'AUTO-TEST', desc: 'Automated Test Case & Validation Packages' },
    ],
  },
  {
    phase: 'Phase 5: Simulation & Validation',
    modules: [
      { name: 'AUTO-SIM', desc: 'Process & PLC Virtual Simulation' },
      { name: 'AUTO-DT', desc: 'Operational Digital Twin Platform' },
    ],
  },
  {
    phase: 'Phase 6: Deployment & Commissioning',
    modules: [
      { name: 'AUTO-COMM', desc: 'Commissioning Assistant & Punchlists' },
      { name: 'AUTO-MIGRATE', desc: 'Legacy PLC & SCADA Migration' },
    ],
  },
  {
    phase: 'Phase 7: Operations',
    modules: [
      { name: 'AUTO-OPS', desc: 'Alarm Rationalization & Analytics' },
      { name: 'AUTO-PERF', desc: 'OEE & Throughput Optimization' },
    ],
  },
  {
    phase: 'Phase 8: Maintenance',
    modules: [
      { name: 'AUTO-CM', desc: 'Vibration & Current Condition Monitoring' },
      { name: 'AUTO-PDM', desc: 'Predictive Maintenance & RUL Forecasting' },
    ],
  },
  {
    phase: 'Phase 9: Continuous Learning',
    modules: [
      { name: 'AUTO-KG', desc: 'Engineering Knowledge Graph Repository' },
      { name: 'AUTO-LEARN', desc: 'Continuous Organizational Pattern Learning' },
    ],
  },
];

const agentTeams = [
  {
    title: 'Design Team Agents',
    agents: ['Process Agent', 'Instrument Agent', 'Electrical Agent', 'Network Agent'],
  },
  {
    title: 'Development Team Agents',
    agents: ['PLC Agent', 'HMI Agent', 'SCADA Agent', 'MES Integration Agent'],
  },
  {
    title: 'Operations Team Agents',
    agents: ['Cybersecurity Agent', 'Maintenance Agent', 'Reliability Agent'],
  },
];
---

<section id="products" class="py-24 bg-bg-panel border-b border-border-subtle">
  <div class="max-w-container mx-auto px-6 md:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-pill bg-accent-primary/10 border border-accent-border text-accent-primary text-xs font-mono font-medium mb-4">
        <Layout className="w-3.5 h-3.5" />
        <span>Product Portfolio & Module Ecosystem</span>
      </div>
      <h2 class="text-display-medium md:text-display-large text-text-primary tracking-tight font-semibold mb-4">
        The AUTO-X Engineering Ecosystem
      </h2>
      <p class="text-body-large text-text-secondary leading-relaxed">
        <strong class="text-text-primary font-medium">PlatX</strong> is the AI-Native Industrial Engineering OS. Specialized <strong class="text-text-primary font-medium">AUTO-X</strong> modules plug into PlatX — starting with PLC software automation and expanding across the entire 9-phase industrial automation lifecycle.
      </p>
    </div>

    <!-- Flagship Product Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-24">
      {flagshipProducts.map((product) => (
        <div class="p-8 rounded-panel bg-bg-page border border-border-standard shadow-sm hover:border-accent-border transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-panel bg-accent-primary/10 border border-accent-border flex items-center justify-center text-accent-primary">
                <product.icon className="w-6 h-6" />
              </div>
              <span class={`px-2.5 py-1 rounded-pill font-mono text-[10px] font-semibold border ${
                product.statusVariant === 'success'
                  ? 'bg-success-bg text-success border-success/30'
                  : 'bg-accent-primary/10 text-accent-primary border-accent-border'
              }`}>
                {product.status}
              </span>
            </div>

            <h3 class="text-sub-heading-large text-text-primary font-semibold mb-1">{product.name}</h3>
            <span class="text-xs font-mono text-accent-primary font-medium block mb-4">{product.tagline}</span>
            <p class="text-xs text-text-secondary leading-relaxed mb-6">{product.description}</p>

            <div class="space-y-2.5 pt-4 border-t border-border-subtle mb-6">
              <span class="text-[10px] font-mono uppercase tracking-wider text-text-tertiary block mb-2">Key Capabilities</span>
              {product.highlights.map((h) => (
                <div class="flex items-start gap-2 text-xs text-text-secondary">
                  <CheckCircle2 className="w-3.5 h-3.5 text-success mt-0.5 flex-shrink-0" />
                  <span>{h}</span>
                </div>
              ))}
            </div>
          </div>

          <a
            href={product.href}
            class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-standard bg-bg-panel border border-border-standard text-xs font-semibold text-text-primary hover:bg-bg-hover hover:border-accent-border transition-all shadow-sm"
          >
            <span>{product.cta}</span>
            <ArrowRight className="w-4 h-4 text-accent-primary" />
          </a>
        </div>
      ))}
    </div>

    <!-- Live Interactive Demo: AUTO-PLC Pipeline Showcase Island -->
    <div class="mb-24">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-widest text-accent-primary font-semibold block mb-2">
          Starter MVP in Action
        </span>
        <h3 class="text-section-heading text-text-primary font-semibold mb-3">
          AUTO-PLC: The Deterministic Pipeline
        </h3>
        <p class="text-sm text-text-secondary">
          Interactive view of the 6 compile-verify gates converting raw user requirements into validated, deployable Siemens TIA Portal Structured Text.
        </p>
      </div>

      <PlcShowcase client:load />
    </div>

    <!-- Multi-Agent Architecture Section -->
    <div class="mb-24 p-8 rounded-panel bg-bg-elevated border border-border-standard">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <Bot className="w-4 h-4 text-accent-primary" />
            <span class="font-mono text-xs uppercase font-semibold text-text-primary tracking-wide">
              Collaborative Multi-Agent Architecture
            </span>
          </div>
          <p class="text-xs text-text-secondary">
            Specialized AI agents work collaboratively through the shared PlatX Engineering Knowledge Graph.
          </p>
        </div>
        <span class="font-mono text-[11px] text-text-tertiary px-3 py-1 rounded-pill bg-bg-panel border border-border-subtle">
          Conceptual Architecture
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {agentTeams.map((team) => (
          <div class="p-5 rounded-card bg-bg-panel border border-border-subtle">
            <h4 class="font-mono text-xs font-semibold text-accent-primary uppercase tracking-wide mb-3">
              {team.title}
            </h4>
            <div class="space-y-2">
              {team.agents.map((agent) => (
                <div class="flex items-center gap-2 text-xs text-text-secondary font-medium p-2 rounded-standard bg-bg-elevated border border-border-subtle">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent-primary"></span>
                  <span>{agent}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- The 9-Phase 30+ Lifecycle Module Grid -->
    <div>
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-mono uppercase tracking-widest text-text-tertiary font-semibold block mb-2">
          Full Lifecycle Vision
        </span>
        <h3 class="text-section-heading text-text-primary font-semibold mb-3">
          The 9-Phase Module Ecosystem
        </h3>
        <p class="text-sm text-text-secondary">
          30+ specialized AI engineering modules designed to cover the full automation lifecycle from Concept to Continuous Improvement.
        </p>
      </div>

      <div class="space-y-8">
        {lifecyclePhases.map((group) => (
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="font-mono text-xs font-semibold text-accent-primary uppercase tracking-wider">
                {group.phase}
              </span>
              <span class="flex-1 h-px bg-border-subtle"></span>
              <span class="font-mono text-[10px] text-text-tertiary uppercase">Conceptual Design</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              {group.modules.map((mod) => (
                <div class="p-4 rounded-card bg-bg-page border border-border-subtle hover:border-border-standard transition-colors flex flex-col justify-between">
                  <div>
                    <span class="font-mono text-xs font-bold text-text-primary block mb-1">
                      {mod.name}
                    </span>
                    <p class="text-[11px] text-text-secondary leading-snug">
                      {mod.desc}
                    </p>
                  </div>
                  <div class="mt-3 pt-2 border-t border-border-subtle flex items-center justify-between">
                    <span class="text-[9px] font-mono text-text-quaternary uppercase">
                      {mod.name === 'AUTO-PLC' ? 'MVP Proof Point' : mod.name === 'AUTO-IO' ? 'PyQt POC' : mod.name === 'AUTO-SAFE' ? 'Post-MVP (Non-AI)' : 'Conceptual Design'}
                    </span>
                    <span class={`w-1.5 h-1.5 rounded-full ${
                      mod.name === 'AUTO-PLC' || mod.name === 'AUTO-IO' ? 'bg-success' : 'bg-text-quaternary'
                    }`}></span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Governance Notice -->
    <div class="mt-16 p-5 rounded-panel bg-bg-elevated border border-border-standard">
      <div class="flex items-start gap-3">
        <ShieldAlert className="w-4 h-4 text-text-tertiary mt-0.5 flex-shrink-0" />
        <p class="font-mono text-[11px] text-text-tertiary leading-relaxed">
          <strong>FIS Truth Domain Governance:</strong> All AUTO-* modules above are conceptual design artifacts within the PlatX vision. Current active implementations: AUTO-PLC (MVP / demo ready with Siemens TIA Portal ST import) and AUTO-IO (technically validated PyQt6 POC). Functional Safety (AUTO-SAFE) is a Post-MVP module under independent human governance and is never automated by AI.
        </p>
      </div>
    </div>

  </div>
</section>
