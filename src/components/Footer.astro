---
import { ShieldCheck, ArrowUp } from 'lucide-react';
import { ThemeToggle } from './ThemeToggle';

const currentYear = new Date().getFullYear();
---

<footer class="bg-bg-panel border-t border-border-standard pt-16 pb-12 transition-colors duration-150">
  <div class="max-w-container mx-auto px-6 md:px-8 lg:px-12">
    
    <!-- Top Row: Brand & Quick Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-border-subtle">
      
      <!-- Brand Summary -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#" class="flex items-center gap-3 group" aria-label="AUTO-X Home">
          <div class="w-8 h-8 rounded-standard bg-accent-primary/10 border border-accent-border flex items-center justify-center text-accent-primary font-bold">
            <span class="font-mono text-xs">AX</span>
          </div>
          <span class="font-semibold text-base tracking-tight text-text-primary">
            AUTO-X · PlatX
          </span>
        </a>

        <p class="text-xs text-text-secondary leading-relaxed max-w-sm">
          Building the software infrastructure for the next generation of industrial engineering. AI-powered engineering tools to design, build, verify, and operate complex industrial automation systems.
        </p>

        <div class="pt-2">
          <span class="font-mono text-[11px] text-text-tertiary block">
            Mission: Make industrial engineering more intelligent, connected, and dramatically more productive.
          </span>
        </div>
      </div>

      <!-- Column 1: Platform -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold text-text-primary uppercase tracking-wider">
          Platform
        </h4>
        <ul class="space-y-2 text-xs text-text-secondary">
          <li><a href="#platx-os" class="hover:text-accent-primary transition-colors">PlatX Operating System</a></li>
          <li><a href="#platx-os" class="hover:text-accent-primary transition-colors">5 Foundational Layers</a></li>
          <li><a href="#products" class="hover:text-accent-primary transition-colors">9-Phase Lifecycle</a></li>
          <li><a href="#products" class="hover:text-accent-primary transition-colors">Multi-Agent Architecture</a></li>
          <li><a href="#pillars" class="hover:text-accent-primary transition-colors">AIR Schema & Drivers</a></li>
        </ul>
      </div>

      <!-- Column 2: Products -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold text-text-primary uppercase tracking-wider">
          Products
        </h4>
        <ul class="space-y-2 text-xs text-text-secondary">
          <li><a href="#products" class="hover:text-accent-primary transition-colors">AUTO-PLC (Starter MVP)</a></li>
          <li><a href="#products" class="hover:text-accent-primary transition-colors">AUTO-IO (PyQt POC)</a></li>
          <li><a href="#products" class="hover:text-accent-primary transition-colors">TIA Openness Bridge</a></li>
          <li><a href="#products" class="hover:text-accent-primary transition-colors">Module Ecosystem (30+)</a></li>
          <li><a href="#contact" class="hover:text-accent-primary transition-colors">Pilot Access Program</a></li>
        </ul>
      </div>

      <!-- Column 3: Governance & Culture -->
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-semibold text-text-primary uppercase tracking-wider">
          Standards & Culture
        </h4>
        <ul class="space-y-2 text-xs text-text-secondary">
          <li><a href="#about" class="hover:text-accent-primary transition-colors">Founder & Leadership</a></li>
          <li><a href="#about" class="hover:text-accent-primary transition-colors">Engineering Values</a></li>
          <li><a href="#faq" class="hover:text-accent-primary transition-colors">Safety Governance (SIL)</a></li>
          <li><a href="#faq" class="hover:text-accent-primary transition-colors">Frequently Asked Questions</a></li>
          <li><a href="#contact" class="hover:text-accent-primary transition-colors">Contact Engineering</a></li>
        </ul>
      </div>

    </div>

    <!-- Governance Statement Box -->
    <div class="my-8 p-5 rounded-panel bg-bg-elevated border border-border-standard">
      <div class="flex items-start gap-3">
        <ShieldCheck className="w-4 h-4 text-accent-primary mt-0.5 flex-shrink-0" />
        <div class="text-[11px] font-mono text-text-tertiary leading-relaxed">
          <strong class="text-text-secondary">AUTO-X Intelligence System Governance:</strong> All AUTO-* modules are conceptual design artifacts within the PlatX vision, with active implementations focused on AUTO-PLC (MVP) and AUTO-IO (POC). Quantitative performance numbers represent target value hypotheses (Level 2 Evidence) under active pilot measurement. Functional Safety (AUTO-SAFE) is a Post-MVP module under independent human certification.
        </div>
      </div>
    </div>

    <!-- Bottom Row: Copyright & Theme Toggle -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-tertiary">
      <div class="flex flex-wrap items-center gap-4">
        <span>&copy; {currentYear} AUTO-X / PlatX. All rights reserved.</span>
        <span>•</span>
        <span>Cairo, Egypt</span>
        <span>•</span>
        <span>Industrial Automation & Industry 4.0</span>
      </div>

      <div class="flex items-center gap-4">
        <ThemeToggle client:load />
        <a
          href="#"
          class="inline-flex items-center gap-1.5 text-xs text-text-secondary hover:text-accent-primary transition-colors"
        >
          <span>Back to top</span>
          <ArrowUp className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</footer>
