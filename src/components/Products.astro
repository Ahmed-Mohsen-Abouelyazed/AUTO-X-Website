---
import { PlcShowcase } from './PlcShowcase';
import { DeterministicFlow } from './DeterministicFlow';
import { AgentOrchestrator } from './AgentOrchestrator';
import {
  Cpu,
  Database,
  Layout,
  ArrowRight,
  CheckCircle2,
  ShieldAlert,
} from 'lucide-react';

const flagshipProducts = [
  {
    id: 'platx',
    icon: Layout,
    name: 'PlatX',
    tagline: 'AI-Native Industrial Engineering Operating System',
    description:
      'The unified platform connecting the complete industrial automation lifecycle. Integrates AI reasoning, encoded domain knowledge, and a unified engineering data model to transform document-driven engineering into a continuous model-driven ecosystem.',
    status: 'Platform Vision',
    statusVariant: 'accent' as const,
    highlights: [
      'Multi-agent system for every engineering discipline',
      'Unified Engineering Data Model (Single Source of Truth)',
      'Standards encoded as deterministic hard rules',
      'Integrated virtual simulation & test oracles',
      'Git-native version control & change management',
      'Multi-vendor projections (Siemens, Rockwell, Schneider, ABB)',
    ],
    cta: 'Explore Platform Vision',
    href: '#platx-os',
  },
  {
    id: 'autoplc',
    icon: Cpu,
    name: 'AUTO-PLC',
    tagline: 'PLC Engineering Workflow Automation',
    description:
      'The first PlatX module and starter MVP proof point. Transforms PLC software engineering from requirements intake to release through a deterministic, AI-assisted 6-stage compiler pipeline.',
    status: 'Demo Ready / MVP',
    statusVariant: 'accent' as const,
    highlights: [
      '6-stage gated engineering pipeline',
      'AI drafts · engines verify · engineers approve',
      'Standards-encoded validation (IEC 61131-3 / ISA-88 / ISA-18.2)',
      'Siemens TIA Portal integration (Structured Text & SCL)',
      'Deterministic, mathematically reproducible emission',
    ],
    cta: 'Book Live Demo',
    href: '#contact',
  },
  {
    id: 'autoio',
    icon: Database,
    name: 'AUTO-IO',
    tagline: 'Automatic I/O Design & Cabinet Layout',
    description:
      'Automates instrument signal mapping, rack allocation, cabinet layouts, and termination diagrams, eliminating weeks of manual spreadsheet errors.',
    status: 'Technically Validated POC',
    statusVariant: 'success' as const,
    highlights: [
      'Automatic I/O rack & channel allocation',
      'Cabinet layout & address mapping generation',
      'Termination diagram PDF generation',
      'Bidirectional graph conflict & safety validation',
      'Multi-scenario comparison & optimization',
    ],
    cta: 'Inquire About POC',
    href: '#contact',
  },
];
---

<section id="products" class="py-24 bg-bg-page border-b border-border-subtle">
  <div class="max-w-container mx-auto px-6 md:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-pill bg-accent-primary/10 border border-accent-border text-accent-primary text-xs font-mono font-medium mb-4">
        <Cpu className="w-3.5 h-3.5" />
        <span>Products & Modules</span>
      </div>
      <h2 class="text-display-medium md:text-display-large text-text-primary tracking-tight font-semibold mb-4">
        Built for Today. Architected for Tomorrow.
      </h2>
      <p class="text-body-large text-text-secondary leading-relaxed">
        From our starter MVP (AUTO-PLC) generating deterministic Siemens SCL logic to the broader PlatX unified engineering platform vision.
      </p>
    </div>

    <!-- Flagship Products 3-Card Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-24">
      {flagshipProducts.map((product) => (
        <div class="p-8 rounded-panel bg-bg-panel border border-border-standard shadow-sm hover:border-accent-border transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <div class="w-12 h-12 rounded-panel bg-accent-primary/10 border border-accent-border flex items-center justify-center text-accent-primary group-hover:scale-105 transition-transform">
                <product.icon className="w-6 h-6" />
              </div>
              <span class={`px-2.5 py-1 rounded-pill font-mono text-[10px] font-semibold border ${
                product.statusVariant === 'success'
                  ? 'bg-success-bg text-success border-success/30'
                  : 'bg-accent-primary/10 text-accent-primary border-accent-border'
              }`}>
                {product.status}
              </span>
            </div>

            <h3 class="text-sub-heading-large text-text-primary font-semibold mb-1">{product.name}</h3>
            <span class="text-xs font-mono text-accent-primary font-medium block mb-4">{product.tagline}</span>
            <p class="text-xs text-text-secondary leading-relaxed mb-6">{product.description}</p>

            <div class="space-y-2.5 pt-4 border-t border-border-subtle mb-6">
              <span class="text-[10px] font-mono uppercase tracking-wider text-text-tertiary block mb-2">Key Capabilities</span>
              {product.highlights.map((h) => (
                <div class="flex items-start gap-2 text-xs text-text-secondary">
                  <CheckCircle2 className="w-3.5 h-3.5 text-success mt-0.5 flex-shrink-0" />
                  <span>{h}</span>
                </div>
              ))}
            </div>
          </div>

          <a
            href={product.href}
            class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-standard bg-bg-panel border border-border-standard text-xs font-semibold text-text-primary hover:bg-bg-hover hover:border-accent-border transition-all shadow-sm"
          >
            <span>{product.cta}</span>
            <ArrowRight className="w-4 h-4 text-accent-primary" />
          </a>
        </div>
      ))}
    </div>

    <!-- Live Interactive Demo: AUTO-PLC Pipeline Showcase Island -->
    <div class="mb-24">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-mono uppercase tracking-widest text-accent-primary font-semibold block mb-2">
          Starter MVP in Action
        </span>
        <h3 class="text-section-heading text-text-primary font-semibold mb-3">
          AUTO-PLC: The 6-Stage Deterministic Pipeline
        </h3>
        <p class="text-sm text-text-secondary">
          Interactive view of the 6 compile-verify gates converting raw user requirements into validated, deployable Siemens TIA Portal Structured Text.
        </p>
      </div>

      <PlcShowcase client:load />
    </div>

    <!-- 5-Phase Deterministic Engineering Flow Island -->
    <div class="mb-24">
      <DeterministicFlow client:load />
    </div>

    <!-- Multi-Agent Swarm Orchestration Console Island -->
    <div class="mb-16">
      <AgentOrchestrator client:load />
    </div>

    <!-- Governance Notice -->
    <div class="mt-16 p-5 rounded-panel bg-bg-elevated border border-border-standard">
      <div class="flex items-start gap-3">
        <ShieldAlert className="w-4 h-4 text-text-tertiary mt-0.5 flex-shrink-0" />
        <p class="font-mono text-[11px] text-text-tertiary leading-relaxed">
          <strong>Truth Domain Governance:</strong> Active implementations currently centered on AUTO-PLC (MVP: demo ready with Siemens TIA Portal ST import) and AUTO-IO (technically validated PyQt6 POC). Functional Safety (AUTO-SAFE) is an explicitly designated Post-MVP capability under certified human governance and is never automated by generative AI.
        </p>
      </div>
    </div>

  </div>
</section>
