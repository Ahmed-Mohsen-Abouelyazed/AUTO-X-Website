---
import { HelpCircle } from 'lucide-react';
import { FaqSearch } from './FaqSearch';
---

<section id="faq" class="py-24 bg-bg-panel border-b border-border-subtle">
  <div class="max-w-container mx-auto px-6 md:px-8 lg:px-12">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-pill bg-accent-primary/10 border border-accent-border text-accent-primary text-xs font-mono font-medium mb-4">
        <HelpCircle className="w-3.5 h-3.5" />
        <span>Frequently Asked Questions</span>
      </div>
      <h2 class="text-display-medium md:text-display-large text-text-primary tracking-tight font-semibold mb-4">
        Answers before you commit.
      </h2>
      <p class="text-body-large text-text-secondary leading-relaxed">
        Search our knowledge base or filter by category to explore deterministic verification, vendor bridges, Functional Safety (SIL), and pilot qualification.
      </p>
    </div>

    <!-- Searchable & Categorized FAQ Island -->
    <div class="max-w-4xl">
      <FaqSearch client:load />
    </div>

  </div>
</section>
